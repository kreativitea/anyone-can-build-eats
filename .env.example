# Copy this file to .env and fill it in. .env is in .gitignore: never commit it.
#
# Leave DATABASE_URL out to use db.sqlite3 on this laptop.
# For Supabase: the project's Connect button -> "Session pooler" -> URI.
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
